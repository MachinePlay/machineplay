# Copy to `.env` and fill in. direnv (`.envrc` runs `dotenv`) exports these
# into the environment; the backend reads them via pydantic-settings.

# --- backend / database ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=machineplay

# --- auth (GitHub OAuth) ---
# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-change-me
# Set true in production so the session cookie is only sent over HTTPS.
COOKIE_SECURE=false

# Create a GitHub OAuth app at https://github.com/settings/developers
#   - Homepage URL:               http://localhost:5173        (prod: https://machineplay.org)
#   - Authorization callback URL: http://localhost:8000/auth/github/callback
#                                 (prod: https://api.machineplay.org/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the OAuth app's "Authorization callback URL" exactly.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Where the browser is sent after a successful login.
FRONTEND_URL=http://localhost:5173

# --- machineplay CLI / runner ---
BACKEND_URL=ws://localhost:8000/ws
MAX_GAMES=4
