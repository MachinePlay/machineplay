# Copy to .env; the defaults all point at production.
BACKEND_URL=ws://localhost:8000/ws
MAX_GAMES=4
MACHINEPLAY_API_URL=http://localhost:8000
MACHINEPLAY_WEB_URL=http://localhost:5173
# The local registry from `just registry` in backend/.
MACHINEPLAY_REGISTRY=127.0.0.1:5000
# Keeps the local token apart from the prod one in ~/.config/machineplay.
XDG_CONFIG_HOME=./creds
ENGINE_MEMORY=512m
ENGINE_CPUS=1
