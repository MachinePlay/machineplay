# --- machineplay CLI / runner ---
BACKEND_URL=ws://localhost:8000/ws
MAX_GAMES=4
# CLI dev tool (login/upload). Defaults point at production; override for local:
MACHINEPLAY_API_URL=http://localhost:8000
MACHINEPLAY_WEB_URL=http://localhost:5173
# Registry the runner pulls engine images from (and the CLI pushes to). A
# co-located runner can pull from the local registry; the public host also works.
MACHINEPLAY_REGISTRY=registry.machineplay.org
# Per-engine container resource limits (passed to `docker run`).
ENGINE_MEMORY=512m
ENGINE_CPUS=1
